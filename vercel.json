{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mustaphadjoghlal.com" }],
      "destination": "https://mustaphadjoghlal.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/hakawati", "destination": "/hakawati.html" },
    { "source": "/hakawati/(.*)", "destination": "/hakawati.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
