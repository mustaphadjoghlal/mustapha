{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mustaphadjoghlal.com"
        }
      ],
      "destination": "https://mustaphadjoghlal.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/brief",
      "destination": "/brief.html"
    },
    {
      "source": "/hakawati",
      "destination": "/hakawati.html"
    },
    {
      "source": "/hakawati/(.*)",
      "destination": "/hakawati.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/compress-image.js": {
      "maxDuration": 60,
      "memory": 1769
    }
  }
}
